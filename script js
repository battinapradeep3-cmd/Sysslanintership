/* =========================================
   EVENTORA — SCRIPT
========================================= */

document.addEventListener("DOMContentLoaded", () => {

    /* =====================================
       EVENT DATA
    ===================================== */

    const events = {
        euphoria: {
            name: "Euphoria Royale",
            date: "20 Sep 2026",
            time: "7:00 PM",
            location: "Vijayawada",
            price: 499
        },

        lunaris: {
            name: "Lunaris",
            date: "25 Sep 2026",
            time: "6:30 PM",
            location: "Visakhapatnam",
            price: 599
        },

        veloura: {
            name: "Veloura",
            date: "02 Oct 2026",
            time: "7:30 PM",
            location: "Hyderabad",
            price: 699
        },

        moonveil: {
            name: "Moonveil",
            date: "05 Oct 2026",
            time: "7:00 PM",
            location: "Bengaluru",
            price: 749
        },

        aurevia: {
            name: "Aurevia",
            date: "18 Oct 2026",
            time: "8:00 PM",
            location: "Mumbai",
            price: 899
        },

        "neon-nights": {
            name: "Neon Nights",
            date: "31 Oct 2026",
            time: "6:00 PM",
            location: "Goa",
            price: 999
        }
    };


    /* =====================================
       BOOKING BUTTONS
    ===================================== */

    const bookingButtons =
        document.querySelectorAll(".book-btn");

    bookingButtons.forEach(button => {

        button.addEventListener("click", () => {

            const link = button.getAttribute("href");

            if (!link) return;

            const params =
                new URLSearchParams(link.split("?")[1]);

            const eventId =
                params.get("event");

            if (!eventId || !events[eventId]) return;

            /*
             * Store selected event temporarily.
             */

            localStorage.setItem(
                "selectedEvent",
                JSON.stringify(events[eventId])
            );

        });

    });


    /* =====================================
       BOOKING PAGE
    ===================================== */

    const selectedEvent =
        JSON.parse(
            localStorage.getItem("selectedEvent")
        );


    const eventNameElement =
        document.getElementById("eventName");

    const eventDateElement =
        document.getElementById("eventDate");

    const eventTimeElement =
        document.getElementById("eventTime");

    const eventLocationElement =
        document.getElementById("eventLocation");

    const ticketPriceElement =
        document.getElementById("ticketPrice");

    const ticketQuantity =
        document.getElementById("ticketQuantity");

    const totalPriceElement =
        document.getElementById("totalPrice");


    if (
        selectedEvent &&
        eventNameElement
    ) {

        eventNameElement.textContent =
            selectedEvent.name;

        if (eventDateElement) {
            eventDateElement.textContent =
                selectedEvent.date;
        }

        if (eventTimeElement) {
            eventTimeElement.textContent =
                selectedEvent.time;
        }

        if (eventLocationElement) {
            eventLocationElement.textContent =
                selectedEvent.location;
        }

        if (ticketPriceElement) {
            ticketPriceElement.textContent =
                `₹${selectedEvent.price}`;
        }

        calculateTotal();

    }


    /* =====================================
       TICKET QUANTITY
    ===================================== */

    if (ticketQuantity) {

        ticketQuantity.addEventListener(
            "input",
            calculateTotal
        );
ticketQuantity.addEventListener(
            "input",
            calculateTotal
        );

    }

    function calculateTotal() {

        if (
            !selectedEvent ||
            !ticketQuantity ||
            !totalPriceElement
        ) {
            return;
        }

        let quantity =
            parseInt(ticketQuantity.value);

        if (isNaN(quantity) || quantity < 1) {
            quantity = 1;
            ticketQuantity.value = 1;
        }

        if (quantity > 10) {
            quantity = 10;
            ticketQuantity.value = 10;
        }

        const total =
            selectedEvent.price * quantity;

        totalPriceElement.textContent =
            `₹${total.toLocaleString("en-IN")}`;

    }


    /* =====================================
       BOOKING FORM
    ===================================== */

    const bookingForm =
        document.getElementById("bookingForm");


    if (bookingForm) {

        bookingForm.addEventListener(
            "submit",
            function(event) {

                event.preventDefault();

                if (!selectedEvent) {

                    alert(
                        "Please select an event first."
                    );

                    return;
                }


                const nameInput =
                    document.getElementById("customerName");

                const emailInput =
                    document.getElementById("customerEmail");

                const phoneInput =
                    document.getElementById("customerPhone");


                const customerName =
                    nameInput
                        ? nameInput.value.trim()
                        : "";

                const customerEmail =
                    emailInput
                        ? emailInput.value.trim()
                        : "";

                const customerPhone =
                    phoneInput
                        ? phoneInput.value.trim()
                        : "";


                if (!customerName) {

                    alert(
                        "Please enter your name."
                    );

                    return;
                }


                if (!customerEmail) {

                    alert(
                        "Please enter your email."
                    );

                    return;
                }


                if (!customerPhone) {

                    alert(
                        "Please enter your phone number."
                    );

                    return;
                }


                const quantity =
                    ticketQuantity
                        ? parseInt(ticketQuantity.value) || 1
                        : 1;


                const total =
                    selectedEvent.price * quantity;


                /* Generate booking ID */

                const bookingId =
                    "EVT-" +
                    Date.now()
                        .toString()
                        .slice(-8);


                /* Create ticket object */

                const ticket = {

                    bookingId: bookingId,

                    eventName:
                        selectedEvent.name,

                    date:
                        selectedEvent.date,

                    time:
                        selectedEvent.time,

                    location:
                        selectedEvent.location,

                    price:
                        selectedEvent.price,

                    quantity:
                        quantity,

                    total:
                        total,

                    customerName:
                        customerName,

                    customerEmail:
                        customerEmail,

                    customerPhone:
                        customerPhone

                };


                /* Get existing tickets */

                let tickets =
                    JSON.parse(
                        localStorage.getItem("myTickets")
                    ) || [];


                /* Add new ticket */

                tickets.push(ticket);


                /* Save */

                localStorage.setItem(
                    "myTickets",
                    JSON.stringify(tickets)
                );


                /* Save latest booking */

                localStorage.setItem(
                    "latestBooking",
                    JSON.stringify(ticket)
                );


                /* Redirect */

                window.location.href =
                    "confirmation.html";

            }
        );

    }


    /* =====================================
       CONFIRMATION PAGE
    ===================================== */

    const latestBooking =
        JSON.parse(
            localStorage.getItem("latestBooking")
        );


    const confirmationEvent =
        document.getElementById(
            "confirmationEvent"
        );

    const confirmationName =
        document.getElementById(
            "confirmationName"
        );

    const confirmationDate =
        document.getElementById(
            "confirmationDate"
        );

    const confirmationLocation =
        document.getElementById(
            "confirmationLocation"
        );

    const confirmationTickets =
        document.getElementById(
            "confirmationTickets"
        );

    const confirmationTotal =
        document.getElementById(
            "confirmationTotal"
        );

    const confirmationId =
        document.getElementById(
            "confirmationId"
        );


    if (
        latestBooking &&
        confirmationEvent
    ) {

        confirmationEvent.textContent =
            latestBooking.eventName;

        if (confirmationName) {
            confirmationName.textContent =
                latestBooking.customerName;
        }

        if (confirmationDate) {
            confirmationDate.textContent =
                `${latestBooking.date} • ${latestBooking.time}`;
        }

        if (confirmationLocation) {
            confirmationLocation.textContent =
                latestBooking.location;
        }

        if (confirmationTickets) {
            confirmationTickets.textContent =
                latestBooking.quantity;
        }

        if (confirmationTotal) {
            confirmationTotal.textContent =
                `₹${latestBooking.total.toLocaleString("en-IN")}`;
        }

        if (confirmationId) {
            confirmationId.textContent =
                latestBooking.bookingId;
        }

    }


    /* =====================================
       MY TICKETS PAGE
    ===================================== */

    const ticketsContainer =
        document.getElementById(
            "ticketsContainer"
        );


    if (ticketsContainer) {

        const tickets =
            JSON.parse(
                localStorage.getItem("myTickets")
            ) || [];


        if (tickets.length === 0) {

            ticketsContainer.innerHTML = `
                <div class="empty-tickets">
                    <div class="empty-icon">🎟️</div>

                    <h3>No Tickets Yet</h3>

                    <p>
                        You haven't booked any events yet.
                        Discover an experience and book your first ticket.
                    </p>

                    <a href="index.html#events">
                        Explore Events
                    </a>
                </div>
            `;

        } else {

            ticketsContainer.innerHTML =
                tickets
                    .map(ticket => {

                        return `
                            <div class="ticket-card">

                                <div class="ticket-main">

                                    <span class="ticket-label">
                                        EVENTORA TICKET
                                    </span>

                                    <h3>
                                        ${ticket.eventName}
                                    </h3>

                                    <p>
                                        📅 ${ticket.date}
                                    </p>

                                    <p>
                                        🕒 ${ticket.time}
                                    </p>

                                    <p>
                                        📍 ${ticket.location}
                                    </p>

                                </div>


                                <div class="ticket-side">

                                    <p>
                                        <strong>
                                            ${ticket.quantity}
                                        </strong>
                                        Ticket${ticket.quantity > 1 ? "s" : ""}
                                    </p>

                                    <p class="ticket-total">
                                        ₹${ticket.total.toLocaleString("en-IN")}
                                    </p>

                                    <small>
                                        ${ticket.bookingId}
                                    </small>

                                </div>

                            </div>
                        `;

                    })
                    .join("");

        }

    }


    /* =====================================
       CONTACT FORM
    ===================================== */

    const contactForm =
        document.querySelector(".contact-form");


    if (contactForm) {

        contactForm.addEventListener(
            "submit",
            function(event) {

                event.preventDefault();

                alert(
                    "Thank you! Your message has been received."
                );

                contactForm.reset();

            }
        );

    }


    /* =====================================
       SMOOTH NAVIGATION
    ===================================== */

    document
        .querySelectorAll('a[href^="#"]')
        .forEach(anchor => {

            anchor.addEventListener(
                "click",
                function(event) {

                    const targetId =
                        this.getAttribute("href");

                    if (
                        targetId === "#" ||
                        !targetId
                    ) {
                        return;
                    }

                    const target =
                        document.querySelector(
                            targetId
                        );

                    if (target) {

                        event.preventDefault();

                        target.scrollIntoView({
                            behavior: "smooth"
                        });

                    }

                }
            );

        });


    /* =====================================
       SCROLL NAVBAR EFFECT
    ===================================== */

    const navbar =
        document.querySelector(".navbar");


    window.addEventListener(
        "scroll",
        () => {

            if (!navbar) return;

            if (window.scrollY > 50) {

                navbar.classList.add(
                    "navbar-scrolled"
                );

            } else {

                navbar.classList.remove(
                    "navbar-scrolled"
                );

            }

        }
    );


    /* =====================================
       IMAGE FALLBACK
    ===================================== */

    document
        .querySelectorAll("img")
        .forEach(img => {

            img.addEventListener(
                "error",
                function() {

                    this.style.display = "none";

                    const parent =
                        this.parentElement;

                    if (parent) {

                        parent.classList.add(
                            "image-error"
                        );

                    }

                }
            );

        });

});
