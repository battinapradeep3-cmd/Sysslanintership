            `;

            container.appendChild(
                card
            );
        }
    );


    container
        .querySelectorAll(
            "[data-cancel-ticket]"
        )
        .forEach(
            function(button) {

                button.addEventListener(
                    "click",
                    function() {

                        cancelTicket(
                            button.getAttribute(
                                "data-cancel-ticket"
                            )
                        );

                    }
                );

            }
        );
}


/* ============================================================
   CANCEL TICKET
   ============================================================ */

function cancelTicket(id) {

    const confirmCancel =
        confirm(
            "Are you sure you want to cancel this ticket?"
        );

    if (!confirmCancel) {
        return;
    }

    let bookings =
        getBookings();

    bookings =
        bookings.filter(
            function(booking) {

                return (
                    booking.id !== id
                );

            }
        );

    saveBookings(
        bookings
    );

    loadTickets();

    alert(
