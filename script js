function setupEventButtons() {

    const cards =
        document.querySelectorAll(
            ".event-card"
        );


    cards.forEach(
        function(card) {

            const heading =
                card.querySelector(
                    "h2, h3, h4"
                );


            const button =
                card.querySelector(
                    "button, .btn"
                );


            if (
                !heading ||
                !button
            ) {
                return;
            }


            const title =
                heading.textContent
                    .replace(
                        /\s+/g,
                        " "
                    )
                    .trim();


            if (
                EVENTS[title]
            ) {

                button.onclick =
                    function(e) {

                        e.preventDefault();

                        showEvent(
                            title
                        );
                    };
            }
        }
    );
}


/* ============================================================
   SIGN IN BUTTON
   Works even if HTML onclick is missing.
   ============================================================ */

function setupSignInButton() {

    let button =
        document.getElementById(
            "authButton"
        );


    if (!button) {

        const possibleButtons =
            document.querySelectorAll(
                "button, a"
            );


        possibleButtons.forEach(
            function(item) {

                const text =
                    item.textContent
                        .trim()
                        .toLowerCase();


                if (
                    text === "sign in" &&
                    !button
                ) {

                    button = item;
                }
            }
        );
    }


    if (!button) {

        console.log(
            "Sign In button not found."
        );

        return;
    }


    button.onclick =
        function(e) {

            e.preventDefault();

            openLogin();
        };
}


