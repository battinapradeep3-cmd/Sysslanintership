/* =========================================================
   AUTOMATIC EVENT BUTTON ACTIONS
   IMPORTANT:
   Even if your HTML button does NOT have onclick,
   this code will make "View Event" buttons work.
   ========================================================= */

function setupEventButtons() {

    const cards =
        document.querySelectorAll(".event-card");

    cards.forEach(function(card) {

        const button =
            card.querySelector("button, .btn");

        const titleElement =
            card.querySelector("h3");

        if (!button || !titleElement) {
            return;
        }

        const title =
            titleElement.textContent
                .trim()
                .toLowerCase();

        let eventId = null;

        if (title === "velvet symphony") {
            eventId = "velvet";
        }

        else if (title === "midnight noir") {
            eventId = "noir";
        }

        else if (title === "aurum jazz") {
            eventId = "aurum";
        }

        else if (title === "grand vintner") {
            eventId = "vintner";
        }

        else if (title === "celestial rooftop") {
            eventId = "celestial";
        }

        else if (title === "imperial opera") {
            eventId = "imperial";
        }

        else if (title === "elysian nights") {
            eventId = "elysian";
        }

        else if (title === "veloura") {
            eventId = "veloura";
        }

        else if (title === "noir élan" ||
                 title === "noir elan") {
            eventId = "noirelan";
        }

        else if (title === "astral reverie") {
            eventId = "astral";
        }

        if (eventId) {

            button.addEventListener("click", function(e) {

                e.preventDefault();
                e.stopPropagation();

                showEvent(eventId);

            });
        }
    });
}


