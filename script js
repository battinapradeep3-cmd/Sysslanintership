        });

}



/* ================= BOOKING ================= */

document
.getElementById("bookingForm")
.addEventListener(
    "submit",
    function (event) {

        event.preventDefault();


        const name =
            document
            .getElementById("name")
            .value
            .trim();


        const email =
            document
            .getElementById("email")
            .value
            .trim();


        const eventName =
            document
            .getElementById("eventSelect")
            .value;


        const ticketType =
            document
            .getElementById("ticketSelect")
            .value;


        const quantity =
            parseInt(
                document
                .getElementById("quantity")
                .value
            );


        const message =
            document
            .getElementById("bookingMessage");


        if (
            !name ||
            !email ||
            !eventName ||
            !ticketType ||
            !quantity
        ) {

            message.innerText =
                "Please complete all booking details.";

            return;

        }


        if (
            quantity < 1 ||
            quantity > 10
        ) {

            message.innerText =
                "You can book between 1 and 10 tickets.";

            return;

        }


        /* Ticket Price */

        if (ticketType === "Essential") {

            ticketPrice = 499;

        }

        else if (ticketType === "Vibe Pass") {

            ticketPrice = 999;

        }

        else if (ticketType === "Legend Pass") {

            ticketPrice = 1999;

        }


        const total =
            ticketPrice * quantity;


        message.innerHTML =

            "🎉 Booking Confirmed!<br><br>" +

            "Name: " + name + "<br>" +

            "Event: " + eventName + "<br>" +

            "Ticket: " + ticketType + "<br>" +

            "Quantity: " + quantity + "<br>" +

            "<strong>Total: ₹" +
            total +
            "</strong>";

    }
);



/* ================= LOGIN ================= */

document
.getElementById("loginForm")
.addEventListener(
    "submit",
    function (event) {

        event.preventDefault();


        const mobile =
            document
            .getElementById("loginMobile")
            .value
            .trim();


        const password =
            document
            .getElementById("password")
            .value
            .trim();


        const message =
            document
            .getElementById("loginMessage");


        if (
            !/^[0-9]{10}$/.test(mobile)
        ) {

            message.innerText =
                "Please enter a valid mobile number.";

            return;

        }


        if (password.length < 4) {

            message.innerText =
                "Please enter a valid password or OTP.";

            return;

        }


        message.innerText =
            "✓ Login successful! Welcome to Party Vibes.";

    }
);



