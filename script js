let selectedEvent = null;


/* =========================
   LOCAL STORAGE
========================= */

function getUser() {

    try {
        return JSON.parse(
            localStorage.getItem("aureliaUser")
        );
    } catch (error) {
        return null;
    }
}


function setUser(user) {
    localStorage.setItem(
        "aureliaUser",
        JSON.stringify(user)
    );
}


function logoutUser() {
    localStorage.removeItem("aureliaUser");
}


function getAccounts() {

    try {
        return JSON.parse(
            localStorage.getItem("aureliaAccounts")
        ) || [];
    } catch (error) {
        return [];
    }
}


function saveAccounts(accounts) {

    localStorage.setItem(
        "aureliaAccounts",
        JSON.stringify(accounts)
    );
}


function getBookings() {

    try {
        return JSON.parse(
            localStorage.getItem("aureliaBookings")
        ) || [];
    } catch (error) {
        return [];
    }
}


function saveBookings(bookings) {

    localStorage.setItem(
        "aureliaBookings",
        JSON.stringify(bookings)
    );
}


/* =========================
   MODALS
========================= */

function openModal(id) {

    const modal = document.getElementById(id);

    if (!modal) {
        console.warn("Modal not found:", id);
        return;
    }

    modal.classList.add("active");

    modal.style.display = "flex";

    document.body.style.overflow = "hidden";
}


function closeModal(id) {

    const modal = document.getElementById(id);

    if (!modal) {
        return;
    }

    modal.classList.remove("active");

    modal.style.display = "none";

    document.body.style.overflow = "";
}


function closeAllModals() {

    document.querySelectorAll(".modal").forEach(function(modal) {

        modal.classList.remove("active");

        modal.style.display = "none";
    });

    document.body.style.overflow = "";
}


/* =========================
   SHOW EVENT
========================= */

function showEvent(eventKey) {

    let event = EVENTS[eventKey];

    if (!event) {

        const normalized =
            String(eventKey)
                .toLowerCase()
                .trim();

        Object.keys(EVENTS).forEach(function(name) {

            if (
                name.toLowerCase() === normalized
            ) {
                event = EVENTS[name];
            }
        });
    }

    if (!event) {

        alert("Event details are not available.");

        return;
    }

    selectedEvent = event;

    setText(
        "eventCategory",
        event.category
    );

    setText(
        "eventTitle",
        event.title || findEventName(event)
    );

    setText(
        "eventDate",
        event.date
    );

    setText(
        "eventTime",
        event.time
    );

    setText(
        "eventLocation",
        event.location
    );

    setText(
        "eventVenue",
        event.venue
    );

    setText(
        "eventDescription",
        event.description
    );

    setText(
        "generalPrice",
        "₹" + event.general
    );

    setText(
        "vipPrice",
        "₹" + event.vip
    );

    setText(
        "vvipPrice",
        "₹" + event.vvip
    );

    openModal("eventModal");
}


function findEventName(event) {

    const names = Object.keys(EVENTS);

    for (let i = 0; i < names.length; i++) {

        if (EVENTS[names[i]] === event) {
            return names[i];
        }
    }

    return "";
}


/* =========================
   SIGN IN
========================= */

function openLogin() {

    const user = getUser();

    if (user) {

        const answer = confirm(
            "You are signed in as " +
            user.name +
            ".\n\nDo you want to Sign Out?"
        );

        if (answer) {
            signOut();
        }

        return;
    }

    openModal("loginModal");
}


/* =========================
   SIGN UP
========================= */

function switchToSignup() {

    closeModal("loginModal");

    openModal("signupModal");
}


function switchToLogin() {

    closeModal("signupModal");

    openModal("loginModal");
}


function handleSignup(e) {

    if (e) {
        e.preventDefault();
    }

    const name =
        getValue("signupName");

    const email =
        getValue("signupEmail").toLowerCase();

    const password =
        getValue("signupPassword");

    if (!name || !email || !password) {

        alert("Please fill all fields.");

        return;
    }

    if (password.length < 6) {

        alert(
            "Password must contain at least 6 characters."
        );

        return;
    }

    const accounts = getAccounts();

    const exists = accounts.some(function(account) {

        return account.email === email;

    });

    if (exists) {

        alert(
            "An account with this email already exists."
        );

        return;
    }

    accounts.push({
        name: name,
        email: email,
        password: password
    });

    saveAccounts(accounts);

    setUser({
        name: name,
        email: email
    });

    closeModal("signupModal");

    updateAuth();

    alert(
        "Account created successfully!"
    );
}


/* =========================
   LOGIN
========================= */

function handleLogin(e) {

    if (e) {
        e.preventDefault();
    }

    const email =
        getValue("loginEmail").toLowerCase();

    const password =
        getValue("loginPassword");

    if (!email || !password) {

        alert(
            "Please enter email and password."
        );

        return;
    }

    const accounts = getAccounts();

    const account = accounts.find(function(item) {

        return (
            item.email === email &&
            item.password === password
        );

    });

    if (!account) {

        alert(
            "Invalid email or password."
        );

        return;
    }

    setUser({
        name: account.name,
        email: account.email
    });

    closeModal("loginModal");

    updateAuth();

    alert(
        "Sign In successful. Welcome " +
        account.name +
        "!"
    );
}


/* =========================
   SIGN OUT
========================= */

function signOut() {

    logoutUser();

    updateAuth();

    alert(
        "You have been signed out."
    );
}


/* =========================
   UPDATE SIGN IN BUTTON
========================= */

function updateAuth() {

    const user = getUser();

    const button =
        document.getElementById("authButton");

    const status =
        document.getElementById("userStatus");

    if (button) {

        button.textContent =
            user ? "Sign Out" : "Sign In";
    }

    if (status) {

        if (user) {

            status.textContent =
                "Welcome, " + user.name;

            status.style.display = "block";

        } else {

            status.textContent = "";

            status.style.display = "none";
        }
    }
}


/* =========================
   BOOKING
========================= */

function startBooking() {

    const user = getUser();

    if (!user) {

        closeModal("eventModal");

        alert(
            "Please Sign In before booking."
        );

        openModal("loginModal");

        return;
    }

    if (!selectedEvent) {

        alert(
            "Please select an event first."
        );

        return;
    }

    const eventName =
        findEventName(selectedEvent);

    setValue(
        "bookingEventName",
        eventName
    );

    setValue(
        "bookingName",
        user.name
    );

    setValue(
        "bookingEmail",
        user.email
    );

    setValue(
        "ticketQuantity",
        "1"
    );

    setValue(
        "ticketType",
        "general"
    );

    updateTotal();

    closeModal("eventModal");

    openModal("bookingModal");
}


/* =========================
   TOTAL
========================= */

function updateTotal() {

    if (!selectedEvent) {
        return;
    }

    const type =
        getValue("ticketType") || "general";

    let quantity =
        parseInt(
            getValue("ticketQuantity"),
            10
        );

    if (
        isNaN(quantity) ||
        quantity < 1
    ) {
        quantity = 1;
        setValue("ticketQuantity", "1");
    }

    if (quantity > 10) {

        quantity = 10;

        setValue(
            "ticketQuantity",
            "10"
        );
    }

    let price =
        selectedEvent.general;

    if (type === "vip") {
        price = selectedEvent.vip;
    }

    if (type === "vvip") {
        price = selectedEvent.vvip;
    }

    const total =
        price * quantity;

    setText(
        "bookingTotal",
        "₹" + total
    );
}


/* =========================
   CONFIRM BOOKING
========================= */

function handleBooking(e) {

    if (e) {
        e.preventDefault();
    }

    const user = getUser();

    if (!user) {

        closeModal("bookingModal");

        openModal("loginModal");

        return;
    }

    if (!selectedEvent) {

        alert(
            "Please select an event."
        );

        return;
    }

    const name =
        getValue("bookingName");

    const email =
        getValue("bookingEmail");

    const phone =
        getValue("bookingPhone");

    const type =
        getValue("ticketType") || "general";

    const quantity =
        parseInt(
            getValue("ticketQuantity"),
            10
        );

    if (!name || !email || !phone) {

        alert(
            "Please fill all booking details."
        );

        return;
    }

    if (
        isNaN(quantity) ||
        quantity < 1
    ) {

        alert(
            "Please select ticket quantity."
        );

        return;
    }

    let price =
        selectedEvent.general;

    if (type === "vip") {
        price = selectedEvent.vip;
    }

    if (type === "vvip") {
        price = selectedEvent.vvip;
    }

    const total =
        price * quantity;

    const bookingId =
        "AUR-" +
        Date.now()
            .toString()
            .slice(-8);

    const booking = {

        id: bookingId,

        event: findEventName(
            selectedEvent
        ),

        date: selectedEvent.date,

        time: selectedEvent.time,

        location: selectedEvent.location,

        venue: selectedEvent.venue,

        name: name,

        email: email,

        phone: phone,

        ticketType: type,

        quantity: quantity,

        total: total
    };

    const bookings =
        getBookings();

    bookings.push(booking);

    saveBookings(bookings);

    closeModal("bookingModal");

    setText(
        "confirmationId",
        bookingId
    );

    setText(
        "confirmationEvent",
        booking.event
    );

    setText(
        "confirmationDate",
        selectedEvent.date +
        " · " +
        selectedEvent.time
    );

    setText(
        "confirmationTickets",
        quantity +
        " × " +
        ticketName(type)
    );

    setText(
        "confirmationTotal",
        "₹" + total
    );

    openModal("confirmationModal");

    loadTickets();
}


/* =========================
   TICKET NAME
========================= */

function ticketName(type) {

    if (type === "vip") {
        return "VIP";
    }

    if (type === "vvip") {
        return "VVIP";
    }

    return "General";
}


/* =========================
   MY TICKETS
========================= */

function loadTickets() {

    const container =
        document.getElementById(
            "ticketsContainer"
        );

    if (!container) {
        return;
    }

    const bookings =
        getBookings();

    if (bookings.length === 0) {

        container.innerHTML = `
            <div class="empty-tickets">
                <h3>No tickets yet</h3>
                <p>
                    Your booked tickets will appear here.
                </p>
            </div>
        `;

        return;
    }

    container.innerHTML = "";

    bookings.forEach(function(booking) {

        const card =
            document.createElement("div");

        card.className =
            "ticket-card";

        card.innerHTML = `

            <div class="ticket-info">

                <small>
                    AURELIA DIGITAL TICKET
                </small>

                <h3>
                    ${safe(booking.event)}
                </h3>

                <p>
                    ${safe(booking.date)}
                    ·
                    ${safe(booking.time)}
                </p>

                <p>
                    ${safe(booking.location)}
                </p>

                <p>
                    ${booking.quantity}
                    ×
                    ${safe(ticketName(
                        booking.ticketType
                    ))}
                </p>

                <strong>
                    ₹${booking.total}
                </strong>

                <p>
                    Booking ID:
                    ${safe(booking.id)}
                </p>

            </div>

            <button
                type="button"
                class="btn btn-outline"
                data-cancel-id="${safe(
                    booking.id
                )}">
                Cancel
            </button>
        `;

        container.appendChild(card);
    });

    container
        .querySelectorAll(
            "[data-cancel-id]"
        )
        .forEach(function(button) {

            button.addEventListener(
                "click",
                function() {

                    cancelTicket(
                        button.getAttribute(
                            "data-cancel-id"
                        )
                    );

                }
            );
        });
}


/* =========================
   CANCEL TICKET
========================= */

function cancelTicket(id) {

    const answer =
        confirm(
            "Are you sure you want to cancel this ticket?"
        );

    if (!answer) {
        return;
    }

    let bookings =
        getBookings();

    bookings =
        bookings.filter(function(item) {

            return item.id !== id;

        });

    saveBookings(bookings);

    loadTickets();

    alert(
        "Ticket cancelled successfully."
    );
}


/* =========================
   EVENT BUTTONS
   THIS FIXES BUTTON ACTIONS
========================= */

function setupEventButtons() {

    const cards =
        document.querySelectorAll(
            ".event-card"
        );

    cards.forEach(function(card) {

        const heading =
            card.querySelector(
                "h2, h3, h4"
            );

        const button =
            card.querySelector(
                "button, .btn, a"
            );

        if (!heading || !button) {
            return;
        }

        const title =
            heading.textContent
                .replace(/\s+/g, " ")
                .trim();

        const event =
            findEventByTitle(title);

        if (!event) {
            return;
        }

        /* Remove old inline action */
        button.removeAttribute(
            "onclick"
        );

        button.addEventListener(
            "click",
            function(e) {

                e.preventDefault();

                showEvent(
                    findEventName(event)
                );

            }
        );
    });
}


function findEventByTitle(title) {

    const cleanTitle =
        title
            .toLowerCase()
            .trim();

    const names =
        Object.keys(EVENTS);

    for (
        let i = 0;
        i < names.length;
        i++
    ) {

        if (
            names[i]
                .toLowerCase()
                .trim() === cleanTitle
        ) {

            return EVENTS[names[i]];
        }
    }

    return null;
}


