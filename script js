   ============================================================ */

function setupModalActions() {

    document
        .querySelectorAll(
            ".modal"
        )
        .forEach(
            function(modal) {

                modal.addEventListener(
                    "click",
                    function(event) {

                        if (
                            event.target ===
                            modal
                        ) {

                            closeModal(
                                modal.id
                            );

                        }

                    }
                );

            }
        );


    document.addEventListener(
        "keydown",
        function(event) {

            if (
                event.key ===
                "Escape"
            ) {

                const eventPage =
                    document.getElementById(
                        "aureliaFullEventPage"
                    );

                if (eventPage) {

                    eventPage.remove();

                    document.body.style.overflow =
                        "";

                    return;
                }

                closeAllModals();

            }

        }
    );
}


