/* ============================================================
   VIEW EVENT BUTTONS
   ============================================================ */

function setupEventButtons() {

    const cards =
        document.querySelectorAll(
            ".event-card"
        );

    cards.forEach(
        function(card) {

            const heading =
                card.querySelector(
                    "h1, h2, h3, h4, h5, h6"
                );

            const button =
                card.querySelector(
                    "button, .btn, a"
                );

            if (
                !heading ||
                !button
            ) {
                return;
            }

            const title =
                heading.textContent
                    .replace(
                        /\s+/g,
                        " "
                    )
                    .trim();

            if (
                EVENTS[title]
            ) {

                /*
                 * Remove normal link behaviour.
                 * Open AURELIA full event page.
                 */

                button.addEventListener(
                    "click",
                    function(event) {

                        event.preventDefault();
                        event.stopPropagation();

                        showEvent(
                            title
                        );

                    }
                );

            }

        }
    );
}


/* ============================================================
   EXTRA EVENT BUTTON FALLBACK
   Works even if card class changes.
   ============================================================ */

function setupEventButtonFallback() {

    const buttons =
        document.querySelectorAll(
            "button, a"
        );

    buttons.forEach(
        function(button) {

            const text =
                button.textContent
                    .replace(
                        /\s+/g,
                        " "
                    )
                    .trim()
                    .toLowerCase();

            if (
                text !== "view event"
            ) {
                return;
            }

            if (
                button.dataset.aureliaReady ===
                "true"
            ) {
                return;
            }

            let card =
                button.closest(
                    ".event-card, article, .card"
                );

            if (!card) {
                return;
            }

            const heading =
                card.querySelector(
                    "h1, h2, h3, h4, h5, h6"
                );

            if (!heading) {
                return;
            }

            const title =
                heading.textContent
                    .replace(
                        /\s+/g,
                        " "
                    )
                    .trim();

            if (
                EVENTS[title]
            ) {

                button.dataset.aureliaReady =
                    "true";

                button.addEventListener(
                    "click",
                    function(event) {

                        event.preventDefault();
                        event.stopPropagation();

                        showEvent(
                            title
                        );

                    }
                );

            }

        }
    );
}


