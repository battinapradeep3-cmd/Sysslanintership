        </div>

        <button
            class="details-book"
            onclick="openBooking('${eventId}')">

            Book Your Experience

        </button>
    `;

    document
        .getElementById("eventModal")
        .classList.add("active");
}


/* ================= MODAL ================= */

function closeModal(id) {

    document
        .getElementById(id)
        .classList.remove("active");
}


/* ================= LOGIN ================= */

function openLogin() {

    document
        .getElementById("loginModal")
        .classList.add("active");
}


function loginUser(event) {

    event.preventDefault();

    const email =
        document.getElementById("loginEmail").value;

    localStorage.setItem(
        "nexoraUser",
        email
    );

    alert(
        "Welcome to NEXORA! Login successful."
    );

    closeModal("loginModal");
}


/* ================= SIGN UP ================= */

function showSignup() {

    closeModal("loginModal");

    document
        .getElementById("signupModal")
        .classList.add("active");
}


function backToLogin() {

    closeModal("signupModal");

    openLogin();
}


function signupUser(event) {

    event.preventDefault();

    const name =
        document.getElementById("signupName").value;

    const email =
        document.getElementById("signupEmail").value;

    localStorage.setItem(
        "nexoraUser",
        JSON.stringify({
            name: name,
            email: email
        })
    );

    alert(
        "Account created successfully! Welcome to NEXORA."
    );

    closeModal("signupModal");

}


/* ================= BOOKING ================= */

function openBooking(eventId) {

    selectedEvent = eventId;

    const event = events[eventId];

    closeModal("eventModal");

    document.getElementById(
        "bookingTitle"
    ).innerText =
        event.name;

    document.getElementById(
        "ticketType"
    ).value = "general";

    document.getElementById(
        "ticketCount"
    ).value = 1;

    updateTotal();

    document
        .getElementById("bookingModal")
        .classList.add("active");
}


/* ================= PRICE CALCULATION ================= */

function updateTotal() {

    if (!selectedEvent) return;

    const event =
        events[selectedEvent];

    const type =
        document.getElementById(
            "ticketType"
        ).value;

    const count =
        Number(
            document.getElementById(
                "ticketCount"
            ).value
        );

    let price = event.general;

    if (type === "vip") {
        price = event.vip;
    }

    if (type === "vvip") {
        price = event.vvip;
    }

    const total =
        price * count;

    document.getElementById(
        "totalPrice"
    ).innerText =
        "₹" + total.toLocaleString("en-IN");
}


/* ================= CONFIRM BOOKING ================= */

function confirmBooking() {

    if (!selectedEvent) return;

    const event =
        events[selectedEvent];

    const type =
        document.getElementById(
            "ticketType"
        ).value;

    const count =
        Number(
            document.getElementById(
                "ticketCount"
            ).value
        );

    let ticketName = "General";

    if (type === "vip") {
        ticketName = "VIP";
    }

    if (type === "vvip") {
        ticketName = "VVIP";
    }

    const booking = {

        event: event.name,

        date: event.date,

        location: event.location,

        ticket: ticketName,

        quantity: count,

        bookingId:
            "NX" +
            Math.floor(
                100000 +
                Math.random() * 900000
            )

    };

    localStorage.setItem(
        "nexoraBooking",
        JSON.stringify(booking)
    );

    closeModal("bookingModal");

    alert(
        "🎉 Booking Confirmed!\n\n" +
        "Event: " + event.name +
        "\nTicket: " + ticketName +
        "\nQuantity: " + count +
        "\nBooking ID: " +
        booking.bookingId
    );

}


/* ================= CONTACT FORM ================= */

function sendMessage(event) {

    event.preventDefault();

    alert(
        "Thank you! Your message has been received."
    );

    event.target.reset();
}


/* ================= OUTSIDE CLICK ================= */

document.addEventListener(
    "click",
    function(event) {

        if (
            event.target.classList.contains("modal")
        ) {

            event.target.classList.remove(
                "active"
            );

        }

    }
);


/* ================= TICKET TYPE CHANGE ================= */

document.addEventListener(
    "change",
    function(event) {

        if (
            event.target.id === "ticketType"
        ) {

            updateTotal();

        }

    }
);
