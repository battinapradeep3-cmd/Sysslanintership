/* ---------- GLOBAL VARIABLES ---------- */

let currentEventId = null;


/* =========================================================
   LOCAL STORAGE
   ========================================================= */

function getUser() {
    try {
        return JSON.parse(localStorage.getItem("aureliaUser")) || null;
    } catch (e) {
        return null;
    }
}

function saveUser(user) {
    localStorage.setItem("aureliaUser", JSON.stringify(user));
}

function removeUser() {
    localStorage.removeItem("aureliaUser");
}

function getAccounts() {
    try {
        return JSON.parse(localStorage.getItem("aureliaAccounts")) || [];
    } catch (e) {
        return [];
    }
}

function saveAccounts(accounts) {
    localStorage.setItem("aureliaAccounts", JSON.stringify(accounts));
}

function getBookings() {
    try {
        return JSON.parse(localStorage.getItem("aureliaBookings")) || [];
    } catch (e) {
        return [];
    }
}

function saveBookings(bookings) {
    localStorage.setItem("aureliaBookings", JSON.stringify(bookings));
}


/* =========================================================
   MODAL FUNCTIONS
   ========================================================= */

function openModal(id) {
    const modal = document.getElementById(id);

    if (modal) {
        modal.classList.add("active");
        modal.style.display = "flex";
        document.body.style.overflow = "hidden";
    }
}

function closeModal(id) {
    const modal = document.getElementById(id);

    if (modal) {
        modal.classList.remove("active");
        modal.style.display = "none";
        document.body.style.overflow = "";
    }
}


/* =========================================================
   EVENT DETAILS
   ========================================================= */

function showEvent(eventId) {

    const event = events[eventId];

    if (!event) {
        alert("Event details not found.");
        return;
    }

    currentEventId = eventId;

    setText("eventCategory", event.category);
    setText("eventTitle", event.title);
    setText("eventDate", event.date);
    setText("eventTime", event.time);
    setText("eventLocation", event.location);
    setText("eventVenue", event.venue);
    setText("eventDescription", event.description);

    setText("generalPrice", "₹" + event.general);
    setText("vipPrice", "₹" + event.vip);
    setText("vvipPrice", "₹" + event.vvip);

    openModal("eventModal");
}


/* =========================================================
   SIGN IN
   ========================================================= */

function openLogin() {

    const user = getUser();

    if (user) {

        const logout = confirm(
            "You are already signed in as " +
            user.name +
            ".\n\nDo you want to Sign Out?"
        );

        if (logout) {
            signOut();
        }

        return;
    }

    openModal("loginModal");
}


/* =========================================================
   SIGN UP
   ========================================================= */

function switchToSignup() {

    closeModal("loginModal");
    openModal("signupModal");
}

function switchToLogin() {

    closeModal("signupModal");
    openModal("loginModal");
}


function handleSignup(event) {

    if (event) {
        event.preventDefault();
    }

    const name = getValue("signupName");
    const email = getValue("signupEmail").toLowerCase();
    const password = getValue("signupPassword");

    if (!name || !email || !password) {
        alert("Please fill all fields.");
        return;
    }

    if (password.length < 6) {
        alert("Password must contain at least 6 characters.");
        return;
    }

    const accounts = getAccounts();

    const existing = accounts.find(function(account) {
        return account.email === email;
    });

    if (existing) {
        alert("An account with this email already exists.");
        return;
    }

    const account = {
        name: name,
        email: email,
        password: password
    };

    accounts.push(account);
    saveAccounts(accounts);

    saveUser({
        name: name,
        email: email
    });

    alert("Account created successfully!");

    closeModal("signupModal");

    updateAuthUI();
}


/* =========================================================
   LOGIN
   ========================================================= */

function handleLogin(event) {

    if (event) {
        event.preventDefault();
    }

    const email = getValue("loginEmail").toLowerCase();
    const password = getValue("loginPassword");

    if (!email || !password) {
        alert("Please enter email and password.");
        return;
    }

    const accounts = getAccounts();

    const account = accounts.find(function(item) {
        return item.email === email &&
               item.password === password;
    });

    if (!account) {
        alert("Invalid email or password.");
        return;
    }

    saveUser({
        name: account.name,
        email: account.email
    });

    alert("Sign In successful. Welcome " + account.name + "!");

    closeModal("loginModal");

    updateAuthUI();
}


/* =========================================================
   LOGOUT
   ========================================================= */

function signOut() {

    removeUser();

    alert("You have been signed out.");

    updateAuthUI();
}


/* =========================================================
   UPDATE NAVBAR
   ========================================================= */

function updateAuthUI() {

    const user = getUser();

    const authButton = document.getElementById("authButton");
    const userStatus = document.getElementById("userStatus");

    if (authButton) {

        if (user) {
            authButton.textContent = "Sign Out";
        } else {
            authButton.textContent = "Sign In";
        }
    }

    if (userStatus) {

        if (user) {
            userStatus.textContent = "Welcome, " + user.name;
            userStatus.style.display = "block";
        } else {
            userStatus.textContent = "";
            userStatus.style.display = "none";
        }
    }
}


/* =========================================================
   START BOOKING
   ========================================================= */

function startBooking() {

    const user = getUser();

    if (!user) {

        alert("Please Sign In before booking a ticket.");

        closeModal("eventModal");
        openModal("loginModal");

        return;
    }

    if (!currentEventId || !events[currentEventId]) {
        alert("Please select an event first.");
        return;
    }

    const event = events[currentEventId];

    setValue("bookingEventName", event.title);

    const nameField = document.getElementById("bookingName");
    const emailField = document.getElementById("bookingEmail");

    if (nameField) {
        nameField.value = user.name;
    }

    if (emailField) {
        emailField.value = user.email;
    }

    const quantity = document.getElementById("ticketQuantity");

    if (quantity) {
        quantity.value = 1;
    }

    const ticketType = document.getElementById("ticketType");

    if (ticketType) {
        ticketType.value = "general";
    }

    updateTotal();

    closeModal("eventModal");

    openModal("bookingModal");
}


/* =========================================================
   CALCULATE TOTAL
   ========================================================= */

function updateTotal() {

    if (!currentEventId || !events[currentEventId]) {
        return;
    }

    const event = events[currentEventId];

    const ticketTypeElement =
        document.getElementById("ticketType");

    const quantityElement =
        document.getElementById("ticketQuantity");

    const totalElement =
        document.getElementById("bookingTotal");

    if (!ticketTypeElement ||
        !quantityElement ||
        !totalElement) {
        return;
    }

    let price = event.general;

    if (ticketTypeElement.value === "vip") {
        price = event.vip;
    }

    if (ticketTypeElement.value === "vvip") {
        price = event.vvip;
    }

    let quantity = parseInt(quantityElement.value, 10);

    if (isNaN(quantity) || quantity < 1) {
        quantity = 1;
        quantityElement.value = 1;
    }

    if (quantity > 10) {
        quantity = 10;
        quantityElement.value = 10;
    }

    const total = price * quantity;

    totalElement.textContent = "₹" + total;
}


/* =========================================================
   BOOK TICKET
   ========================================================= */

function handleBooking(event) {

    if (event) {
        event.preventDefault();
    }

    const user = getUser();

    if (!user) {
        alert("Please Sign In first.");
        closeModal("bookingModal");
        openModal("loginModal");
        return;
    }

    const eventData = events[currentEventId];

    if (!eventData) {
        alert("Please select an event.");
        return;
    }

    const name = getValue("bookingName");
    const email = getValue("bookingEmail");
    const phone = getValue("bookingPhone");
    const ticketType = getValue("ticketType");
    const quantity =
        parseInt(getValue("ticketQuantity"), 10);

    if (!name || !email || !phone) {
        alert("Please fill all booking details.");
        return;
    }

    if (!quantity || quantity < 1) {
        alert("Please select at least 1 ticket.");
        return;
    }

    let price = eventData.general;

    if (ticketType === "vip") {
        price = eventData.vip;
    }

    if (ticketType === "vvip") {
        price = eventData.vvip;
    }

    const total = price * quantity;

    const bookingId =
        "AUR-" +
        Date.now().toString().slice(-8);

    const booking = {

        id: bookingId,

        eventId: currentEventId,

        event: eventData.title,

        date: eventData.date,

        time: eventData.time,

        location: eventData.location,

        venue: eventData.venue,

        name: name,

        email: email,

        phone: phone,

        ticketType: ticketType,

        quantity: quantity,

        total: total,

        createdAt: new Date().toISOString()
    };

    const bookings = getBookings();

    bookings.push(booking);

    saveBookings(bookings);

    closeModal("bookingModal");

    setText("confirmationId", bookingId);
    setText("confirmationEvent", eventData.title);
    setText(
        "confirmationDate",
        eventData.date + " · " + eventData.time
    );
    setText(
        "confirmationTickets",
        quantity +
        " × " +
        formatTicketType(ticketType)
    );
    setText("confirmationTotal", "₹" + total);

    openModal("confirmationModal");

    loadTickets();
}


/* =========================================================
   TICKET TYPE
   ========================================================= */

function formatTicketType(type) {

    if (type === "vip") {
        return "VIP";
    }

    if (type === "vvip") {
        return "VVIP";
    }

    return "General";
}


/* =========================================================
   MY TICKETS
   ========================================================= */

function loadTickets() {

    const container =
        document.getElementById("ticketsContainer");

    if (!container) {
        return;
    }

    const bookings = getBookings();

    if (bookings.length === 0) {

        container.innerHTML = `
            <div class="empty-tickets">
                <h3>No tickets yet</h3>
                <p>Book an event and your tickets will appear here.</p>
            </div>
        `;

        return;
    }

    container.innerHTML = "";

    bookings.forEach(function(booking) {

        const ticket = document.createElement("div");

        ticket.className = "ticket-card";

        ticket.innerHTML = `
            <div class="ticket-info">
                <small>AURELIA DIGITAL TICKET</small>

                <h3>${escapeHTML(booking.event)}</h3>

                <p>
                    ${escapeHTML(booking.date)}
                    ·
                    ${escapeHTML(booking.time)}
                </p>

                <p>
                    ${escapeHTML(booking.location)}
                    ·
                    ${escapeHTML(booking.venue)}
                </p>

                <p>
                    ${booking.quantity}
                    ×
                    ${escapeHTML(formatTicketType(booking.ticketType))}
                </p>

                <strong>₹${booking.total}</strong>

                <p>Booking ID: ${escapeHTML(booking.id)}</p>
            </div>

            <button
                class="btn btn-outline"
                type="button"
                onclick="cancelTicket('${booking.id}')">
                Cancel
            </button>
        `;

        container.appendChild(ticket);
    });
}


/* =========================================================
   CANCEL TICKET
   ========================================================= */

function cancelTicket(id) {

    const confirmCancel =
        confirm("Are you sure you want to cancel this ticket?");

    if (!confirmCancel) {
        return;
    }

    let bookings = getBookings();

    bookings = bookings.filter(function(booking) {
        return booking.id !== id;
    });

    saveBookings(bookings);

    loadTickets();

    alert("Ticket cancelled successfully.");
}


