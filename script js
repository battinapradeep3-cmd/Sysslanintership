/* ================= AUTH ================= */

function openLogin() {

    const user = getCurrentUser();

    if (user) {

        signOut();

        return;
    }

    openModal("loginModal");
}


function switchToSignup() {

    closeModal("loginModal");

    openModal("signupModal");
}


function switchToLogin() {

    closeModal("signupModal");

    openModal("loginModal");
}


/* ================= SIGN UP ================= */

function handleSignup(event) {

    event.preventDefault();


    const name =
        document.getElementById("signupName").value.trim();

    const email =
        document.getElementById("signupEmail").value
            .trim()
            .toLowerCase();

    const password =
        document.getElementById("signupPassword").value;


    if (!name || !email || !password) {

        alert("Please fill all fields.");

        return;
    }


    if (password.length < 6) {

        alert("Password must contain at least 6 characters.");

        return;
    }


    const accounts = getAccounts();


    const existingAccount = accounts.find(
        function (account) {
            return account.email === email;
        }
    );


    if (existingAccount) {

        alert(
            "An account with this email already exists. Please sign in."
        );

        return;
    }


    const newAccount = {

        name: name,
        email: email,
        password: password
    };


    accounts.push(newAccount);

    saveAccounts(accounts);


    localStorage.setItem(
        "aureliaUser",
        JSON.stringify({
            name: name,
            email: email
        })
    );


    document.getElementById("signupForm").reset();

    closeModal("signupModal");

    updateAuthUI();

    alert(
        "Welcome to AURELIA, " + name + "!"
    );
}


/* ================= LOGIN ================= */

function handleLogin(event) {

    event.preventDefault();


    const email =
        document.getElementById("loginEmail").value
            .trim()
            .toLowerCase();

    const password =
        document.getElementById("loginPassword").value;


    const accounts = getAccounts();


    const account = accounts.find(
        function (item) {

            return (
                item.email === email &&
                item.password === password
            );

        }
    );


    if (!account) {

        alert(
            "Invalid email or password."
        );

        return;
    }


    localStorage.setItem(
        "aureliaUser",
        JSON.stringify({
            name: account.name,
            email: account.email
        })
    );


    document.getElementById("loginForm").reset();

    closeModal("loginModal");

    updateAuthUI();

    alert(
        "Welcome back, " + account.name + "!"
    );
}


/* ================= SIGN OUT ================= */

function signOut() {

    localStorage.removeItem("aureliaUser");

    updateAuthUI();

    alert("You have been signed out.");
}


/* ================= AUTH UI ================= */

function updateAuthUI() {

    const user = getCurrentUser();

    const status =
        document.getElementById("userStatus");

    const button =
        document.getElementById("authButton");


    if (!status || !button) return;


    if (user) {

        status.textContent =
            "Hi, " + user.name;

        button.textContent =
            "Sign Out";

    } else {

        status.textContent = "";

        button.textContent =
            "Sign In";
    }
}


/* ================= START BOOKING ================= */

function startBooking() {

    if (!currentEventId) {

        alert("Please select an event first.");

        return;
    }


    const user = getCurrentUser();


    if (!user) {

        closeModal("eventModal");

        alert(
            "Please sign in before booking your ticket."
        );

        openModal("loginModal");

        return;
    }


    const event = events[currentEventId];


    document.getElementById("bookingEventName").textContent =
        event.title;

    document.getElementById("bookingName").value =
        user.name;

    document.getElementById("bookingEmail").value =
        user.email;


    document.getElementById("ticketType").value =
        "general";

    document.getElementById("ticketQuantity").value =
        1;


    updateTotal();


    closeModal("eventModal");

    openModal("bookingModal");
}


/* ================= CALCULATE TOTAL ================= */

function updateTotal() {

    if (!currentEventId) return;


    const event = events[currentEventId];


    const ticketType =
        document.getElementById("ticketType").value;


    let quantity =
        parseInt(
            document.getElementById("ticketQuantity").value,
            10
        );


    if (isNaN(quantity) || quantity < 1) {
        quantity = 1;
    }


    if (quantity > 10) {
        quantity = 10;
    }


    document.getElementById("ticketQuantity").value =
        quantity;


    const price =
        event.prices[ticketType];


    const total =
        price * quantity;


    document.getElementById("bookingTotal").textContent =
        "₹" + total.toLocaleString("en-IN");
}


/* ================= BOOKING ID ================= */

function generateBookingId() {

    const randomNumber =
        Math.floor(
            100000 + Math.random() * 900000
        );

    return "AUR-" + randomNumber;
}


/* ================= HANDLE BOOKING ================= */

function handleBooking(event) {

    event.preventDefault();


    if (!currentEventId) {

        alert("Please select an event.");

        return;
    }


    const currentUser =
        getCurrentUser();


    if (!currentUser) {

        closeModal("bookingModal");

        openModal("loginModal");

        return;
    }


    const selectedEvent =
        events[currentEventId];


    const name =
        document.getElementById("bookingName")
            .value.trim();

    const email =
        document.getElementById("bookingEmail")
            .value.trim()
            .toLowerCase();

    const phone =
        document.getElementById("bookingPhone")
            .value.trim();

    const ticketType =
        document.getElementById("ticketType")
            .value;

    let quantity =
        parseInt(
            document.getElementById("ticketQuantity")
                .value,
            10
        );


    /* Validation */

    if (!name) {

        alert("Please enter your name.");

        return;
    }


    if (!email) {

        alert("Please enter your email.");

        return;
    }


    if (!/^[0-9]{10}$/.test(phone)) {

        alert(
            "Please enter a valid 10-digit phone number."
        );

        return;
    }


    if (
        isNaN(quantity) ||
        quantity < 1 ||
        quantity > 10
    ) {

        alert(
            "Ticket quantity must be between 1 and 10."
        );

        return;
    }


    const price =
        selectedEvent.prices[ticketType];


    const total =
        price * quantity;


    const bookingId =
        generateBookingId();


    const booking = {

        bookingId: bookingId,

        eventId: currentEventId,

        eventName: selectedEvent.title,

        category: selectedEvent.category,

        date: selectedEvent.date,

        time: selectedEvent.time,

        location: selectedEvent.location,

        venue: selectedEvent.venue,

        name: name,

        email: email,

        phone: phone,

        ticketType: ticketType,

        ticketQuantity: quantity,

        total: total,

        createdAt: new Date().toISOString()
    };


    const bookings =
        getBookings();


    bookings.push(booking);

    saveBookings(bookings);


    /* Confirmation details */

    document.getElementById("confirmationId")
        .textContent = bookingId;

    document.getElementById("confirmationEvent")
        .textContent = selectedEvent.title;

    document.getElementById("confirmationDate")
        .textContent =
        selectedEvent.date +
        " · " +
        selectedEvent.time;

    document.getElementById("confirmationTickets")
        .textContent =
        quantity +
        " × " +
        formatTicketType(ticketType);

    document.getElementById("confirmationTotal")
        .textContent =
        "₹" +
        total.toLocaleString("en-IN");


    document.getElementById("bookingForm").reset();


    closeModal("bookingModal");

    loadTickets();

    openModal("confirmationModal");
}


/* ================= FORMAT TICKET TYPE ================= */

function formatTicketType(type) {

    if (type === "general") {
        return "General";
    }

    if (type === "vip") {
        return "VIP";
    }

    if (type === "vvip") {
        return "VVIP";
    }

    return type;
}


/* ================= ESCAPE HTML ================= */

function escapeHTML(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/* ================= LOAD MY TICKETS ================= */

function loadTickets() {

    const ticketList =
        document.getElementById("ticketList");


    if (!ticketList) return;


    const user =
        getCurrentUser();


    if (!user) {

        ticketList.innerHTML = `

            <div class="empty-tickets">

                <h3>Sign In Required</h3>

                <p>
                    Sign in to view your booked tickets.
                </p>

                <button
                    class="btn btn-primary"
                    onclick="openLogin()">
                    Sign In
                </button>

            </div>
        `;

        return;
    }


    const bookings =
        getBookings();


    const userBookings =
        bookings.filter(
            function (booking) {

                return booking.email === user.email;

            }
        );


    if (userBookings.length === 0) {

        ticketList.innerHTML = `

            <div class="empty-tickets">

                <h3>No tickets yet</h3>

                <p>
                    Book an event and your tickets
                    will appear here.
                </p>

                <a
                    href="#events"
                    class="btn btn-primary">
                    Explore Events
                </a>

            </div>
        `;

        return;
    }


    ticketList.innerHTML =
        userBookings.map(
            function (booking) {

                return `

                    <div class="ticket-card">

                        <h3>
                            ${escapeHTML(
                                booking.eventName
                            )}
                        </h3>

                        <div class="ticket-id">
                            BOOKING ID:
                            ${escapeHTML(
                                booking.bookingId
                            )}
                        </div>


                        <div class="ticket-details">

                            <div>
                                <span>DATE</span>

                                <strong>
                                    ${escapeHTML(
                                        booking.date
                                    )}
                                </strong>
                            </div>


                            <div>
                                <span>TIME</span>

                                <strong>
                                    ${escapeHTML(
                                        booking.time
                                    )}
                                </strong>
                            </div>


                            <div>
                                <span>LOCATION</span>

                                <strong>
                                    ${escapeHTML(
                                        booking.location
                                    )}
                                </strong>
                            </div>


                            <div>
                                <span>VENUE</span>

                                <strong>
                                    ${escapeHTML(
                                        booking.venue
                                    )}
                                </strong>
                            </div>


                            <div>
                                <span>TICKET TYPE</span>

                                <strong>
                                    ${formatTicketType(
                                        booking.ticketType
                                    )}
                                </strong>
                            </div>


                            <div>
                                <span>TICKETS</span>

                                <strong>
                                    ${booking.ticketQuantity}
                                </strong>
                            </div>

                        </div>


                        <div class="ticket-footer">

                            <div class="ticket-total">
                                ₹${Number(
                                    booking.total
                                ).toLocaleString("en-IN")}
                            </div>

                            <button
                                class="cancel-ticket"
                                onclick="cancelTicket('${escapeHTML(
                                    booking.bookingId
                                )}')">

                                Cancel Ticket

                            </button>

                        </div>

                    </div>
                `;

            }
        ).join("");
}


/* ================= CANCEL TICKET ================= */

function cancelTicket(bookingId) {

    const user =
        getCurrentUser();


    if (!user) {

        alert(
            "Please sign in to manage your tickets."
        );

        return;
    }


    const bookings =
        getBookings();


    const booking =
        bookings.find(
            function (item) {

                return (
                    item.bookingId === bookingId &&
                    item.email === user.email
                );

            }
        );


    if (!booking) {

        alert("Ticket not found.");

        return;
    }


    const confirmed =
        confirm(
            "Are you sure you want to cancel this ticket?"
        );


    if (!confirmed) return;


    const updatedBookings =
        bookings.filter(
            function (item) {

                return item.bookingId !== bookingId;

            }
        );


    saveBookings(updatedBookings);

    loadTickets();


    alert(
        "Ticket " +
        bookingId +
        " has been cancelled."
    );
}


/* ================= NAVIGATION ================= */

document.addEventListener(
    "DOMContentLoaded",
    function () {

        updateAuthUI();

        loadTickets();


        /* Update tickets whenever My Tickets is clicked */

        const ticketLink =
            document.querySelector(
                'a[href="#tickets"]'
            );


        if (ticketLink) {

            ticketLink.addEventListener(
                "click",
                function () {

                    loadTickets();

                }
            );

        }


        /* Mobile / normal navigation */

        document
            .querySelectorAll(".nav-links a")
            .forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function () {

                            const target =
                                link.getAttribute("href");


                            if (target === "#tickets") {
                                loadTickets();
                            }

                        }
                    );

                }
            );

    }
);

