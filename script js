/* ============================================================
   SIGNUP
   ============================================================ */

function handleSignup(event) {

    if (event) {
        event.preventDefault();
    }


    const name =
        getValue("signupName");


    const email =
        getValue("signupEmail")
            .toLowerCase();


    const password =
        getValue("signupPassword");


    if (
        !name ||
        !email ||
        !password
    ) {

        alert(
            "Please fill all fields."
        );

        return;
    }


    if (
        password.length < 6
    ) {

        alert(
            "Password must contain at least 6 characters."
        );

        return;
    }


    const accounts =
        getAccounts();


    const alreadyExists =
        accounts.some(
            function(account) {

                return (
                    account.email ===
                    email
                );

            }
        );


    if (alreadyExists) {

        alert(
            "This email is already registered."
        );

        return;
    }


    accounts.push({

        name: name,

        email: email,

        password: password

    });


    saveAccounts(
        accounts
    );


    saveUser({

        name: name,

        email: email

    });


    closeModal(
        "signupModal"
    );


    updateAuthUI();


    alert(
        "Account created successfully!"
    );
}


