/* =========================================================
   LOGIN
   ========================================================= */

function openLogin() {

    const user = getCurrentUser();

    if (user) {
        signOut();
        return;
    }

    openModal("loginModal");
}


/* =========================================================
   SWITCH LOGIN / SIGNUP
   ========================================================= */

function switchToSignup() {

    closeModal("loginModal");
    openModal("signupModal");
}


function switchToLogin() {

    closeModal("signupModal");
    openModal("loginModal");
}


/* =========================================================
   SIGNUP
   ========================================================= */

function handleSignup(event) {

    event.preventDefault();

    const name =
        document.getElementById("signupName").value.trim();

    const email =
        document.getElementById("signupEmail").value.trim()
            .toLowerCase();

    const password =
        document.getElementById("signupPassword").value;

    if (!name || !email || !password) {
        alert("Please fill all fields.");
        return;
    }

    if (password.length < 6) {
        alert("Password must contain at least 6 characters.");
        return;
    }

    let accounts = getAccounts();

    const existingAccount = accounts.find(function (account) {
        return account.email === email;
    });

    if (existingAccount) {
        alert("An account with this email already exists.");
        return;
    }

    const newAccount = {
        name: name,
        email: email,
        password: password
    };

    accounts.push(newAccount);

    localStorage.setItem(
        "aureliaAccounts",
        JSON.stringify(accounts)
    );

    localStorage.setItem(
        "aureliaUser",
        JSON.stringify({
            name: name,
            email: email
        })
    );

    alert("Account created successfully! Welcome to AURELIA.");

    document.getElementById("signupForm").reset();

    closeModal("signupModal");

    updateAuthUI();
}


/* =========================================================
   LOGIN
   ========================================================= */

function handleLogin(event) {

    event.preventDefault();

    const email =
        document.getElementById("loginEmail").value.trim()
            .toLowerCase();

    const password =
        document.getElementById("loginPassword").value;

    if (!email || !password) {
        alert("Please enter email and password.");
        return;
    }

    const accounts = getAccounts();

    const account = accounts.find(function (user) {
        return user.email === email &&
            user.password === password;
    });

    if (!account) {
        alert(
            "Invalid email or password.\n\n" +
            "If you are a new user, please create an account first."
        );
        return;
    }

    localStorage.setItem(
        "aureliaUser",
        JSON.stringify({
            name: account.name,
            email: account.email
        })
    );

    alert("Login successful. Welcome, " + account.name + "!");

    document.getElementById("loginForm").reset();

    closeModal("loginModal");

    updateAuthUI();
}


/* =========================================================
   SIGN OUT
   ========================================================= */

function signOut() {

    localStorage.removeItem("aureliaUser");

    updateAuthUI();

    alert("You have been signed out.");

}


/* =========================================================
   UPDATE NAVBAR AUTH UI
   ========================================================= */

function updateAuthUI() {

    const userStatus =
        document.getElementById("userStatus");

    const authButton =
        document.getElementById("authButton");

    const user = getCurrentUser();

    if (!user) {

        if (userStatus) {
            userStatus.textContent = "";
        }

        if (authButton) {
            authButton.textContent = "Sign In";
            authButton.onclick = openLogin;
        }

        return;
    }

    if (userStatus) {
        userStatus.textContent =
            "Hi, " + user.name;
    }

    if (authButton) {
        authButton.textContent = "Sign Out";
        authButton.onclick = signOut;
    }

}


/* =========================================================
   START BOOKING
   ========================================================= */

function startBooking() {

    if (!currentEventId ||
        !events[currentEventId]) {

        alert("Please select an event first.");
        return;
    }

    const user = getCurrentUser();

    if (!user) {

        alert(
            "Please sign in or create an account before booking."
        );

        closeModal("eventModal");

        openModal("loginModal");

        return;
    }

    const event = events[currentEventId];

    const bookingEventName =
        document.getElementById("bookingEventName");

    if (bookingEventName) {
        bookingEventName.textContent =
            event.title;
    }

    document.getElementById("bookingName").value =
        user.name;

    document.getElementById("bookingEmail").value =
        user.email;

    document.getElementById("bookingPhone").value = "";

    document.getElementById("ticketType").value =
        "general";

    document.getElementById("ticketQuantity").value =
        "1";

    updateTotal();

    closeModal("eventModal");

    openModal("bookingModal");
}


/* =========================================================
   UPDATE BOOKING TOTAL
   ========================================================= */

function updateTotal() {

    if (!currentEventId ||
        !events[currentEventId]) {

        return;
    }

    const event = events[currentEventId];

    const ticketType =
        document.getElementById("ticketType").value;

    const quantity =
        parseInt(
            document.getElementById("ticketQuantity").value,
            10
        ) || 1;

    const price =
        event.prices[ticketType];

    const total =
        price * quantity;

    const bookingTotal =
        document.getElementById("bookingTotal");

    if (bookingTotal) {
        bookingTotal.textContent =
            "₹" + total.toLocaleString("en-IN");
    }

}


/* =========================================================
   GENERATE BOOKING ID
   ========================================================= */

function generateBookingId() {

    const random =
        Math.floor(100000 + Math.random() * 900000);

    return "AUR-" + random;

}


/* =========================================================
   CONFIRM BOOKING
   ========================================================= */

function handleBooking(event) {

    event.preventDefault();

    if (!currentEventId ||
        !events[currentEventId]) {

        alert("Please select an event.");
        return;
    }

    const eventData =
        events[currentEventId];

    const name =
        document.getElementById("bookingName")
            .value.trim();

    const email =
        document.getElementById("bookingEmail")
            .value.trim();

    const phone =
        document.getElementById("bookingPhone")
            .value.trim();

    const ticketType =
        document.getElementById("ticketType")
            .value;

    const quantity =
        parseInt(
            document.getElementById("ticketQuantity")
                .value,
            10
        );

    if (!name || !email || !phone) {
        alert("Please fill all booking details.");
        return;
    }

    if (!/^[0-9]{10}$/.test(phone)) {
        alert("Please enter a valid 10-digit mobile number.");
        return;
    }

    if (!quantity ||
        quantity < 1 ||
        quantity > 10) {

        alert("Ticket quantity must be between 1 and 10.");
        return;
    }

    const price =
        eventData.prices[ticketType];

    const total =
        price * quantity;

    const bookingId =
        generateBookingId();

    const booking = {

        bookingId: bookingId,

        eventId: currentEventId,

        eventName: eventData.title,

        date: eventData.date,

        time: eventData.time,

        location: eventData.location,

        venue: eventData.venue,

        name: name,

        email: email,

        phone: phone,

        ticketType: ticketType,

        ticketQuantity: quantity,

        total: total,

        createdAt: new Date().toISOString()

    };


    const bookings =
        getBookings();

    bookings.push(booking);

    saveBookings(bookings);


    /* Fill confirmation modal */

    document.getElementById("confirmationId")
        .textContent = bookingId;

    document.getElementById("confirmationEvent")
        .textContent = eventData.title;

    document.getElementById("confirmationName")
        .textContent = name;

    document.getElementById("confirmationDate")
        .textContent =
        eventData.date + " · " + eventData.time;

    document.getElementById("confirmationLocation")
        .textContent =
        eventData.location;

    document.getElementById("confirmationTickets")
        .textContent =
        quantity +
        " × " +
        formatTicketType(ticketType);

    document.getElementById("confirmationTotal")
        .textContent =
        "₹" + total.toLocaleString("en-IN");


    document.getElementById("bookingForm")
        .reset();

    closeModal("bookingModal");

    loadTickets();

    openModal("confirmationModal");

}


/* =========================================================
   FORMAT TICKET TYPE
   ========================================================= */

function formatTicketType(type) {

    if (type === "general") {
        return "General";
    }

    if (type === "vip") {
        return "VIP";
    }

    if (type === "vvip") {
        return "VVIP";
    }

    return type;
}


/* =========================================================
   LOAD MY TICKETS
   ========================================================= */

function loadTickets() {

    const ticketList =
        document.getElementById("ticketList");

    if (!ticketList) {
        return;
    }

    const bookings =
        getBookings();

    if (bookings.length === 0) {

        ticketList.innerHTML = `
            <div class="empty-tickets">
                <h3>No Tickets Yet</h3>
                <p>
                    Your booked events will appear here.
                </p>
            </div>
        `;

        return;
    }


    ticketList.innerHTML = "";


    bookings.forEach(function (booking) {

        const ticketCard =
            document.createElement("div");

        ticketCard.className =
            "ticket-card";


        ticketCard.innerHTML = `

            <div class="ticket-details">

                <div>
                    <span class="ticket-label">
                        BOOKING ID
                    </span>

                    <strong>
                        ${escapeHTML(booking.bookingId)}
                    </strong>
                </div>

                <div>
                    <span class="ticket-label">
                        EVENT
                    </span>

                    <strong>
                        ${escapeHTML(booking.eventName)}
                    </strong>
                </div>

                <div>
                    <span class="ticket-label">
                        DATE & TIME
                    </span>

                    <span>
                        ${escapeHTML(booking.date)}
                        ·
                        ${escapeHTML(booking.time)}
                    </span>
                </div>

                <div>
                    <span class="ticket-label">
                        LOCATION
                    </span>

                    <span>
                        ${escapeHTML(booking.location)}
                    </span>
                </div>

                <div>
                    <span class="ticket-label">
                        TICKETS
                    </span>

                    <span>
                        ${booking.ticketQuantity}
                        ×
                        ${escapeHTML(
                            formatTicketType(
                                booking.ticketType
                            )
                        )}
                    </span>
                </div>

                <div>
                    <span class="ticket-label">
                        TOTAL
                    </span>

                    <strong>
                        ₹${booking.total.toLocaleString("en-IN")}
                    </strong>
                </div>

            </div>

            <button
                class="cancel-ticket"
                onclick="cancelTicket('${booking.bookingId}')"
            >
                Cancel Ticket
            </button>

        `;


        ticketList.appendChild(ticketCard);

    });

}


