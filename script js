/* =========================================
   8. TICKET COUNT LIMIT
   ========================================= */

const ticketCount =
    document.getElementById("ticketCount");


ticketCount.addEventListener("change", function () {

    if (this.value < 1) {

        this.value = 1;

    }

    if (this.value > 10) {

        this.value = 10;

    }

});

